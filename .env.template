# Copy to .env and fill in. NEVER commit .env (see .gitignore). (Infra task S7)

# Shared Gemma inference server (Infra task S3).
# One teammate runs `docker-compose.ollama.yml` on a host with a GPU.
# Everyone else points MODEL_ENDPOINT at that host — do not run Ollama locally
# unless you are the designated host operator.
#
# Retrieval does not use this; generation/answering (task A3) will.
#
# Examples:
#   MODEL_ENDPOINT=http://10.0.0.12:11434
#   MODEL_ENDPOINT=http://heinzy-gpu.andrew.cmu.edu:11434
MODEL_ENDPOINT=http://REPLACE_WITH_SHARED_HOST:11434

# Shared Chroma vector DB (Infra task S4).
# Host operator runs `docker-compose.chroma.yml`. Teammates set the host IP.
# Works from Mac and Windows clients (HTTP). Also set config:
#   vector_store.backend: chroma
#
# Host operator:     CHROMA_HOST=127.0.0.1
# Teammates (LAN):   CHROMA_HOST=192.168.1.158
CHROMA_HOST=REPLACE_WITH_SHARED_HOST
CHROMA_PORT=8000
