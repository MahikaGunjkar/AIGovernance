# Copy to .env and fill in. NEVER commit .env (see .gitignore). (Infra task S7)

# Shared Gemma inference (Infra task S3 / issue #16).
# Primary: host operator runs notebooks/colab_gemma_ollama_host.ipynb on Colab
# (GPU + NGROK_AUTHTOKEN secret) and posts the current HTTPS tunnel URL.
# The URL CHANGES every Colab/ngrok restart — update this value when generation
# stops working. Do not commit live URLs.
#
# Generation calls {MODEL_ENDPOINT}/api/chat (Ollama). Retrieval does not use this.
#
# Examples:
#   MODEL_ENDPOINT=https://abc123.ngrok-free.app
#   MODEL_ENDPOINT=http://10.0.0.12:11434
#     (optional LAN fallback via docker-compose.ollama.yml)
MODEL_ENDPOINT=https://phosphate-mongrel-premises.ngrok-free.dev/

# Ollama has no authentication of its own, and its API can pull and delete
# models rather than only answering questions, so the shared tunnel should carry
# basic auth. Set the pair the host operator gives you. Leave blank when the
# tunnel is open. Generation and scripts/check_model_host.py both send it.
MODEL_BASIC_AUTH=

# Shared Chroma vector DB (Infra task S4).
# Host operator runs `docker-compose.chroma.yml`. Teammates set the host IP.
# Works from Mac and Windows clients (HTTP). Also set config:
#   vector_store.backend: chroma
#
# Host operator:     CHROMA_HOST=127.0.0.1
# Teammates (LAN):   CHROMA_HOST=192.168.1.158
CHROMA_HOST=REPLACE_WITH_SHARED_HOST
CHROMA_PORT=8000

