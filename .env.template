# Copy to .env and fill in. NEVER commit .env (see .gitignore). (Infra task S7)

# ---- Generation provider ---------------------------------------------------
# ollama (default) | azure_openai
MODEL_PROVIDER=ollama

# --- Ollama (MODEL_PROVIDER=ollama) ----------------------------------------
# Generation calls {MODEL_ENDPOINT}/api/chat. Retrieval does not use this.
#
# Examples:
#   MODEL_ENDPOINT=http://localhost:11434
#   MODEL_ENDPOINT=https://abc123.ngrok-free.app
#   MODEL_ENDPOINT=http://10.0.0.12:11434
MODEL_ENDPOINT=http://localhost:11434

# Optional basic auth for a shared Ollama tunnel. Leave blank for local Ollama.
MODEL_BASIC_AUTH=

# Optional override of config.yaml model.tag (Ollama tag or Azure deployment label).
# MODEL_TAG=

# --- Azure OpenAI / AI Foundry (MODEL_PROVIDER=azure_openai) ---------------
# App/Chroma stay wherever you run them (laptop or GCP VM). Only generation
# calls Azure. No local GPU / Ollama required for answers.
#
# Foundry example:
#   MODEL_PROVIDER=azure_openai
#   AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.services.ai.azure.com
#   AZURE_OPENAI_API_KEY=...
#   AZURE_OPENAI_DEPLOYMENT=Llama-3.3-70B-Instruct
#   AZURE_OPENAI_API_VERSION=2024-10-21
#
# Classic Azure OpenAI (*.openai.azure.com) uses the same variables.
#
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# Shared Chroma vector DB (Infra task S4).
# Host operator runs `docker-compose.chroma.yml`. Teammates set the host IP.
# Works from Mac and Windows clients (HTTP). Also set config:
#   vector_store.backend: chroma
#
# Host operator:     CHROMA_HOST=127.0.0.1
# Teammates (LAN):   CHROMA_HOST=192.168.1.158
CHROMA_HOST=REPLACE_WITH_SHARED_HOST
CHROMA_PORT=8000

# Governance PEP mount (feature/governance-policies worktree — do not edit that branch).
# Docker compose sets these inside the container; for local runs point at a worktree:
#   git worktree add ../AIGovernance-governance feature/governance-policies
#   GOVERNANCE_SRC=../AIGovernance-governance/src
#   GOVERNANCE_POLICY_PATH=../AIGovernance-governance/policies/governance_policy.yaml
# GOVERNANCE_SRC=
