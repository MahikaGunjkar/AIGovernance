# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# ---- Generation provider ---------------------------------------------------
# ollama (default) | azure_openai
MODEL_PROVIDER=ollama

# --- Local Ollama (MODEL_PROVIDER=ollama) ----------------------------------
# Generation calls {MODEL_ENDPOINT}/api/chat. Retrieval does not use this.
MODEL_ENDPOINT=http://localhost:11434

# Optional basic auth if you put a reverse proxy in front of Ollama.
MODEL_BASIC_AUTH=

# Optional override of config.yaml model.tag
# MODEL_TAG=gemma3:12b

# --- Azure AI Foundry / OpenAI (MODEL_PROVIDER=azure_openai) ---------------
# App + handbook stay local (or on your VM). Only generation calls Azure.
#
#   MODEL_PROVIDER=azure_openai
#   AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.services.ai.azure.com
#   AZURE_OPENAI_API_KEY=...
#   AZURE_OPENAI_DEPLOYMENT=Llama-3.3-70B-Instruct
#   AZURE_OPENAI_API_VERSION=2024-10-21
#
# Classic host also works: https://YOUR_RESOURCE.openai.azure.com
# Full steps: azurereadme.md
#
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Chroma (optional persistent store) ------------------------------------
# config.yaml → vector_store.backend: chroma
# Host: CHROMA_HOST=127.0.0.1
# Teammate LAN: CHROMA_HOST=<host-ip>
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000

# ---- Governance PEP mount (optional) ---------------------------------------
# git worktree add ../AIGovernance-governance feature/governance-policies
# GOVERNANCE_SRC=../AIGovernance-governance/src
# GOVERNANCE_POLICY_PATH=../AIGovernance-governance/policies/governance_policy.yaml
# GOVERNANCE_HOST_PATH=../AIGovernance-governance
